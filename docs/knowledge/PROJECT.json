{
  "schema_version": 1,
  "id": "Eating_behavior",
  "display_name": "Eating Behavior",
  "description": "猫咪视频流检测、身份确认、进食与姿态事件推理工程。",
  "status": "active",
  "domains": ["cat-behavior", "realtime-video", "pose-estimation", "identity", "events"],
  "entrypoints": [
    {
      "path": "src/eating_behavior/main.py",
      "purpose": "视频文件、目录、摄像头和网络流统一 CLI 入口"
    },
    {
      "path": "src/eating_behavior/pipeline.py",
      "purpose": "正式实时推理流水线"
    },
    {
      "path": "configs/pipeline.yaml",
      "purpose": "视频源、身份、事件和流水线运行配置"
    },
    {
      "path": "configs/models.yaml",
      "purpose": "受控生产模型注册表"
    },
    {
      "path": "tools/run_live_annotated_recording.py",
      "purpose": "单路直播的实时分析、标注、分段录像与 RTMP 发布入口"
    },
    {
      "path": "tools/extract_every_50_frames.py",
      "purpose": "可恢复、可校验的按源帧间隔视频抽帧入口"
    },
    {
      "path": "tools/flatten_extracted_frames.py",
      "purpose": "带 CSV 源映射的抽取帧扁平化发布入口"
    },
    {
      "path": "web/stream-viewer/server.mjs",
      "purpose": "认证实时视频查看服务"
    }
  ],
  "verification": [
    "python -m pytest -q",
    "python -m py_compile tools/extract_every_50_frames.py tools/flatten_extracted_frames.py",
    "npm --prefix web/stream-viewer run check",
    "npm --prefix web/stream-viewer test",
    "systemd-analyze verify deploy/systemd/eating-behavior-camera02-ai-live.service deploy/systemd/eating-behavior-camera02-annotated.service web/stream-viewer/deploy/joyai-stream-viewer.service"
  ],
  "source_docs": [
    "README.md",
    "docs/realtime_pipeline.md",
    "docs/rtmpose_integration.md",
    "docs/knowledge/DECISIONS/0001-camera02-analysis-path.md",
    "web/stream-viewer/README.md",
    "training/README.md"
  ],
  "watch_rules": [
    {
      "paths": [
        "src/eating_behavior/main.py",
        "src/eating_behavior/pipeline.py",
        "src/eating_behavior/media.py",
        "tools/run_live_annotated_recording.py"
      ],
      "knowledge": ["pipeline", "source", "runtime", "live-inference"]
    },
    {
      "paths": [
        "src/eating_behavior/identity.py",
        "src/eating_behavior/association.py",
        "src/eating_behavior/tracking.py",
        "src/eating_behavior/pose.py",
        "src/eating_behavior/posture.py"
      ],
      "knowledge": ["identity", "tracking", "pose", "posture"]
    },
    {
      "paths": [
        "src/eating_behavior/events.py",
        "src/eating_behavior/eating_state.py",
        "src/eating_behavior/presence_state.py"
      ],
      "knowledge": ["event", "state-machine"]
    },
    {
      "paths": ["configs/**", "src/eating_behavior/config.py", "src/eating_behavior/models.py"],
      "knowledge": ["config", "model", "model-governance"]
    },
    {
      "paths": ["web/stream-viewer/**"],
      "knowledge": ["viewer", "deployment"]
    },
    {
      "paths": ["deploy/**"],
      "knowledge": ["deployment"]
    },
    {
      "paths": ["requirements/**", "requirements.txt", "pyproject.toml"],
      "knowledge": ["dependency", "verification"]
    },
    {
      "paths": [
        "tools/extract_every_50_frames.py",
        "tools/flatten_extracted_frames.py"
      ],
      "knowledge": ["training", "dataset-preparation", "privacy"]
    },
    {
      "paths": ["training/**"],
      "knowledge": ["training", "model-candidate"]
    }
  ],
  "excluded_content": [
    "RTSP or HTTP credentials",
    "customer and household mappings",
    "raw frames and videos",
    "model weights",
    "W&B cache and training data",
    "production event contents"
  ]
}
