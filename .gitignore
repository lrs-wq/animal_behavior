__pycache__/
*.py[cod]
*.pyo

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

.venv/
venv/
env/

outputs/
# Local datasets may be a directory or an absolute-path symlink.
/data

# Local W&B artifact cache may live outside training/.
/.wandb_cache/

# Operator snapshots and editor backups are not source.
*.backup-*
*.bak
*~

# Raw video and extracted JPEG frames stay out of Git. Curated documentation
# assets use PNG/SVG and are intentionally not covered by these rules.
*.avi
*.m4v
*.mkv
*.mov
*.mp4
*.webm
*.jpg
*.jpeg

# Python package/build metadata.
*.egg-info/
build/
dist/

# Model artifacts are promoted to models/ out of band and pinned by SHA-256.
*.pt
*.pth
*.onnx
*.engine
*.npz
*.npy

# Local training, prediction, tuning and experiment output.
/training/*.generated.yaml
/training/predictions/
/training/runs*/
/training/wandb/
/wandb/

*.log
.DS_Store
Thumbs.db
